{
    "manifest_version": 3,
    "name": "DappFence",
    "version": "0.1.0",
    "description": "Auto-injects DappFence on sites listed in sites.json.",
    "icons": {
        "16": "icon-16.png",
        "32": "icon-32.png",
        "48": "icon-48.png",
        "128": "icon-128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "DappFence",
        "default_icon": {
            "16": "icon-16.png",
            "32": "icon-32.png"
        }
    },
    "host_permissions": ["*://*/sw-api/status"],
    "background": { "service_worker": "background.js" },
    "permissions": ["scripting", "activeTab", "tabs"]
}
