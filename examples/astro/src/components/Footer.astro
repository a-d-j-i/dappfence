---
const year = new Date().getFullYear();
---

<footer>
    <div class="inner">
        <span class="brand">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"></path>
            </svg>
            DappFence
        </span>
        <span>Example integration with Astro</span>
        <span class="right">&copy; {year}</span>
    </div>
</footer>

<style>
    footer {
        border-top: 1px solid var(--border);
        background: var(--bg-2);
        padding: 1.25em 1em;
    }
    .inner {
        width: 920px;
        max-width: calc(100% - 2em);
        margin: auto;
        display: flex;
        align-items: center;
        gap: 1.25em;
        flex-wrap: wrap;
        font-size: 0.8em;
        color: var(--text-muted);
    }
    .brand {
        display: flex;
        align-items: center;
        gap: 0.35em;
        font-weight: 600;
        color: var(--text-2);
    }
    .brand svg {
        color: var(--accent);
    }
    .right {
        margin-left: auto;
    }
    @media (max-width: 600px) {
        .right {
            margin-left: 0;
        }
    }
</style>
