---
import ThemeToggle from './ThemeToggle.astro';
---

<header>
    <nav>
        <a href="/" class="logo">
            <svg class="logo-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"></path>
            </svg>
            <span>DappFence</span>
        </a>
        <div class="nav-right">
            <a href="/about" class="nav-link">About</a>
            <span class="nav-pill">Astro Example</span>
            <ThemeToggle />
        </div>
    </nav>
</header>

<style>
    header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(9, 11, 21, 0.88);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    nav {
        width: 920px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 0;
        height: 3.5em;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #e2e8f0;
    }
    .logo {
        display: flex;
        align-items: center;
        gap: 0.45em;
        font-weight: 700;
        font-size: 1em;
        color: #e2e8f0;
        text-decoration: none;
        letter-spacing: -0.01em;
    }
    .logo:hover {
        color: #a5b4fc;
        text-decoration: none;
    }
    .logo span {
        line-height: 1;
    }
    .logo-icon {
        width: 18px;
        height: 18px;
        color: #818cf8;
        flex-shrink: 0;
    }
    .nav-right {
        display: flex;
        align-items: center;
        gap: 0.75em;
    }
    .nav-link {
        font-size: 0.85em;
        font-weight: 600;
        color: #94a3b8;
        text-decoration: none;
    }
    .nav-link:hover {
        color: #a5b4fc;
    }
    .nav-pill {
        font-size: 0.7em;
        font-weight: 600;
        padding: 0.3em 0.8em;
        border-radius: 100px;
        background: rgba(129, 140, 248, 0.14);
        color: #818cf8;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        line-height: 1;
    }
</style>
